#!/usr/bin/env bash
# SovereignAI Edge CLI launcher — run from the project root:
#   ./sovereign list
#   ./sovereign chat llama3:8b
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Prefer the backend venv (used during dev), else the root venv (created by launch.sh).
# Handles both POSIX (bin/python) and Windows-in-git-bash (Scripts/python.exe) layouts.
if [ -x "$ROOT/backend/.venv/bin/python" ]; then
    PY="$ROOT/backend/.venv/bin/python"
elif [ -x "$ROOT/backend/.venv/Scripts/python.exe" ]; then
    PY="$ROOT/backend/.venv/Scripts/python.exe"
elif [ -x "$ROOT/.venv/bin/python" ]; then
    PY="$ROOT/.venv/bin/python"
else
    PY="$ROOT/.venv/Scripts/python.exe"
fi

if [ ! -x "$PY" ]; then
    echo "[ERROR] Virtual environment not found. Run launch.sh once to set it up." >&2
    exit 1
fi

cd "$ROOT/backend/app"
exec "$PY" -m cli.main "$@"
