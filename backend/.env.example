# SovereignAI Edge — backend environment template
#
# Every value below is OPTIONAL: app/config.py defines a working default for
# each one, so the app runs with no .env at all.
#
# To use it, copy this file to `.env` in this folder (backend/) and uncomment
# what you need:
#
#     cd backend
#     copy .env.example .env      # Windows
#     cp .env.example .env        # Linux / macOS
#
# Notes
#   * `env_file=".env"` is resolved relative to the process working directory,
#     and the launch scripts run the backend from `backend/` — so `.env` belongs
#     here, next to `main.py`.
#   * `.env` is git-ignored. NEVER commit real credentials or tokens.
#   * Settings saved through the UI / settings DB take precedence for anything
#     they cover; these variables are the bootstrap/override layer.

# --- Where writable data lives -------------------------------------------------
# Root for workspace/, models/, databases (sovereign.db, sovereign_settings.db)
# and caches. Defaults to the repo root in a dev checkout, and to
# %LOCALAPPDATA%\SovereignAI for a frozen build. Point it at a portable folder
# to keep everything on one drive (the Electron shell sets this automatically
# in portable mode).
#SOVEREIGN_DATA_ROOT=D:\SovereignAI-data

# --- Server -------------------------------------------------------------------
#SOVEREIGN_HOST=127.0.0.1
#SOVEREIGN_PORT=8000
# Extra logging. Do not enable on a shared/untrusted network.
#SOVEREIGN_DEBUG=false
# App log level: DEBUG | INFO | WARNING | ERROR
#SOVEREIGN_LOG_LEVEL=INFO
# Dev only: uvicorn hot reload (roughly doubles startup cost).
#SOVEREIGN_RELOAD=0

# --- Paths (defaults live under <data root>/workspace) ------------------------
#SOVEREIGN_WORKSPACE_DIR=
#SOVEREIGN_MODELS_DIR=
#SOVEREIGN_DATABASE_PATH=
#SOVEREIGN_PLUGINS_DIR=
#SOVEREIGN_CATALOG_DIR=

# --- Resource limits ----------------------------------------------------------
# Fraction of total RAM the engines may use.
#SOVEREIGN_MAX_RAM_USAGE_PERCENT=0.75
#SOVEREIGN_KV_CACHE_MAX_MB=2048
#SOVEREIGN_LAYER_PREFETCH_COUNT=2

# --- Model defaults -----------------------------------------------------------
#SOVEREIGN_DEFAULT_MODE=auto
#SOVEREIGN_DEFAULT_QUANT=Q4_K_M

# --- Security -----------------------------------------------------------------
# Executes arbitrary Python shipped inside a model repo. Leave false unless you
# fully trust the model source.
#SOVEREIGN_TRUST_REMOTE_CODE=false
#SOVEREIGN_ENCRYPTION_ENABLED=true
#SOVEREIGN_AUDIT_LOGGING=true

# --- Experimental (default OFF) ------------------------------------------------
# TurboQuant KV-cache compression. Keep off until the accuracy gate passes;
# see reviews/ and Info_docs/tech-stack/turboquant.md.
#SOVEREIGN_TURBOQUANT_ENABLED=false
#SOVEREIGN_TURBOQUANT_BITS=3.5
#SOVEREIGN_TURBOQUANT_QJL_ENABLED=true

# --- CLI ----------------------------------------------------------------------
# Base URL the `sovereign` CLI talks to (overrides the port from the settings DB).
#SOVEREIGN_API_BASE=http://127.0.0.1:8000

# --- Model downloads ----------------------------------------------------------
# Path to a custom CA bundle for HuggingFace HTTPS downloads (corporate proxies).
#SOVEREIGN_CA_BUNDLE=

# --- Hugging Face cache -------------------------------------------------------
# Redirected into the workspace automatically. Override only if you need the
# cache somewhere else.
#HF_HOME=

# --- Frontend (build time only) -----------------------------------------------
# Set in `frontend/.env.local`, not here. The packaged app defaults to
# http://127.0.0.1:8000.
#NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
