{
  "name": "sovereign-ai-desktop",
  "version": "1.0.0",
  "description": "SovereignAI Edge Desktop Application",
  "author": {
    "name": "SovereignAI",
    "email": "contact@sovereignai.local"
  },
  "homepage": "https://github.com/sovereignai/edge",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:win:dir": "electron-builder --win --x64 --dir",
    "build:win:prepackaged": "electron-builder --win nsis --x64 --prepackaged",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.sovereignai.edge",
    "productName": "SovereignAI",
    "directories": {
      "output": "../build_exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "menu.js",
      "tray.js",
      "assets/icon.ico",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "../build_exe/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../frontend/out",
        "to": "frontend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "SovereignAI",
      "signAndEditExecutable": false,
      "artifactName": "SovereignAI-Setup-x64.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SovereignAI",
      "uninstallDisplayName": "SovereignAI",
      "deleteAppDataOnUninstall": false,
      "artifactName": "SovereignAI-Setup-x64.exe"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
